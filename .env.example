# Copy to .env (gitignored) and fill in. Every setting is optional.

# Linear: personal API key (Settings → Account → Security & access → API keys).
LINEAR_API_KEY=

# Source control. Unset: GitHub, through the gh CLI's own login.
# "bitbucket": Bitbucket Server / Data Center's REST API. Make a personal HTTP access token with
# read access to projects and repositories (Profile → Manage account → HTTP access tokens).
# MC_SCM=bitbucket
# BITBUCKET_URL=https://bitbucket.example.com
# BITBUCKET_TOKEN=

# Server address. Keep it on loopback: nothing here does authentication.
# MC_HOST=127.0.0.1
# MC_PORT=4317

# Other machines' Cleons to show beside this one (docs/PORTING.md, "A second machine"): name=URL,
# comma-separated. Either ssh://<host>, an ssh_config Host alias that logs in with a key: Cleon runs the SSH
# forward to that machine's loopback-only Cleon (port 4317) itself and keeps it up. Or a loopback URL for a
# forward you run yourself, e.g. ssh -N -L 127.0.0.1:4319:127.0.0.1:4317 worker. Anything else is refused.
# MC_PEERS=worker=ssh://worker

# 1 on a machine nobody sits at (a worker you reach over RDP or a tunnel): jumps, orchestrator restarts and
# herdr updates focus herdr panes but never raise or open a window there.
# MC_HEADLESS=1

# Repos live at <MC_ROOT>/<category>/<repo>. Default root: ~/dev.
# MC_ROOT=C:/dev
# Comma-separated category folders under MC_ROOT. Unset: every folder under it.
# MC_CATEGORIES=Work,Tooling

# Orchestration runs/plans used when no plugin config names any.
# Each repo's .claude/workflow.local.json paths.runs_root is read regardless.
# MC_RUNS_DIR=C:/wt/.orchestrate-runs
# MC_PLANS_DIR=C:/wt/plans

# What Cleon assumes about your orchestration tool's run files (see docs/RUN-FORMAT.md).
# Unset: the orchestration plugin's (lib/adapters/orchestration-plugin.mjs).
# MC_ORCH_ADAPTER=./my-adapter.mjs

# Obsidian vault. Not read for now: the knowledge map shows each project's own files until vault pages return to it.
# MC_VAULT=C:/dev/knowledge

# Knowledge map: the folders (matched at any depth, in any case) that hold each project's docs, comms and outputs.
# A group named here gets exactly this list; the others keep their defaults, which are:
# MC_KNOWLEDGE_FOLDERS=docs=docs,adrs,decisions;comms=communications,meetings,transcripts;outputs=output,outputs,reports

# Privacy: a case-insensitive regex. Matching paths never enter the knowledge graph, file tiles,
# or session dialog reads. Unset: nothing is excluded, and the server warns at startup.
# MC_EXCLUDE=secret[\s_-]?project|payroll

# Inbox (docs/PORTING.md, "The Inbox scan"): 1 turns on a scheduled, read-only Claude scan of your Microsoft 365
# calendar, mail and Teams chats through the claude.ai Microsoft 365 connector: it flags Teams meetings whose
# transcript isn't filed in their project, and looks for answers to your Waiting on items. Off by default: it
# reads your calendar and mail, and costs money (about $0.01 a scan on Haiku).
# MC_SCAN=1
# Local hours to scan at, comma-separated. Default: 8,12,16
# MC_SCAN_HOURS=8,12,16
# Model for the scan (and for Ingest's session). Default: haiku. Sonnet matched the same meetings at 20x the cost.
# MC_SCAN_MODEL=haiku
# Most one scan may spend, in dollars (claude --max-budget-usd). Default: 1
# MC_SCAN_BUDGET=1

# Project map: the Git for Windows install, for "open in bash". Default: C:/Program Files/Git
# MC_GIT_DIR=

# Docker Desktop disk file. Default: %LOCALAPPDATA%/Docker/wsl/disk/docker_data.vhdx
# MC_DOCKER_DISK=
